# Look at what's open from an angle, fit to the view. Pass this to FreeCAD after
# a STEP file: it leaves the camera of one opened from the command line looking
# down at the origin, zoomed in.
#
# It also saves the document, which FreeCAD otherwise leaves "Unnamed" and asks
# to save on exit, under tmp/freecad/ at the STEP file's path in the repo:
# gen/games/jenga/box-strip.step becomes tmp/freecad/gen/games/jenga/box-strip.FCStd.
#
# Then it watches the STEP file, and when it's written again, as by generating,
# reimports it into the same document, keeping the camera and what's hidden, so
# FreeCAD needn't be restarted to see a change. While the file is gone, as when
# generating deletes it to write it again, or its object is no longer in the
# project, or generating failed, the document's tab says so.
#
# FreeCAD imports a piece of several solids as a group of them: each is made
# one object again, so that a group is only ever one the project made.
#
# What the file holds goes in an assembly, named for the file, with its groups
# as the assembly's parts: so that the Assembly workbench's exploded views can
# pull it apart: it opens in that workbench, the assembly active, as its
# commands want it. Those are kept through a reload, by the labels of what they
# move, and a reload waits for an open task, such as one being edited.
import hashlib
import re
import sys
from pathlib import Path

import CommandCreateView
import FreeCAD
import FreeCADGui as Gui
import ImportGui
import Part
import UtilsAssembly
from PySide import QtCore

# How often to look at the STEP file, in milliseconds.
POLL = 500
# What the tab says while the file is gone.
GONE = " (missing)"


def save(doc, saved: Path) -> None:
    # The import leaves its objects touched, which would still count as a change
    # to save.
    doc.recompute()
    doc.saveAs(str(saved))
    Gui.getDocument(doc.Name).Modified = False


def whole(doc) -> None:
    """Make one object of each piece that was imported as a group of its
    solids. Such a group holds nothing but shapes, named as it is but for the
    digits FreeCAD ends a taken label with, and all of one look. A group the
    project made of pieces so alike becomes one object too."""

    def base(o) -> str:
        return re.sub(r"\s*\d*$", "", o.Label)

    def look(o) -> tuple:
        return (o.ViewObject.ShapeColor, o.ViewObject.Transparency)

    def split(o) -> bool:
        if o.TypeId != "App::Part":
            return False
        solids = o.Group
        return (
            len(solids) > 1
            and all(s.TypeId == "Part::Feature" for s in solids)
            and {base(s) for s in solids} == {base(o)}
            and len({look(s) for s in solids}) == 1
        )

    def mend(group) -> None:
        held = []
        for o in group.Group:
            if not split(o):
                if o.TypeId == "App::Part":
                    mend(o)
                held.append(o)
                continue
            solids = o.Group
            # The first has the piece's own name.
            piece = doc.addObject("Part::Feature", solids[0].Name + "_whole")
            piece.Shape = Part.makeCompound([s.Shape for s in solids])
            piece.Placement = o.Placement
            piece.ViewObject.ShapeAppearance = solids[0].ViewObject.ShapeAppearance
            piece.ViewObject.Transparency = solids[0].ViewObject.Transparency
            label = solids[0].Label
            for gone in [*solids, o]:
                doc.removeObject(gone.Name)
            piece.Label = label
            held.append(piece)
        # In the order they came.
        group.Group = held

    # But for the file's own compound, whatever it's called.
    for root in doc.RootObjects:
        if root.TypeId == "App::Part":
            mend(root)


def assemble(doc, assembly=None):
    """Put what was imported in an assembly, in place of the part the STEP
    file's own compound came in as, and return it: the one given, on a reload,
    or a new one. It's one assembly for as long as the document is open, since
    it's being edited, and FreeCAD crashes over an edited object that's gone."""
    whole(doc)
    roots = [root for root in doc.RootObjects if root != assembly]
    made = assembly is None
    if made:
        assembly = doc.addObject("Assembly::AssemblyObject", "Assembly")
        assembly.Type = "Assembly"
        assembly.newObject("Assembly::JointGroup", "Joints")
    for root in roots:
        if root.TypeId != "App::Part":
            assembly.addObject(root)
            continue
        for child in root.Group:
            assembly.addObject(child)
        # Its label is the file's name, and free once it's gone.
        label = root.Label
        doc.removeObject(root.Name)
        if made:
            assembly.Label = label
    if made:
        # Active, which the workbench's commands are grayed out without.
        Gui.getDocument(doc.Name).setEdit(assembly)
    return assembly


def exploded(doc) -> list:
    """The document's exploded views, to make again of what's imported next:
    the label of each and its moves, a move being its label, type, transform
    and what it moves. Those are paths of labels, from the assembly down, since
    an import names its objects by the order they come in."""
    views = []
    for view in doc.Objects:
        if not isinstance(getattr(view, "Proxy", None), CommandCreateView.ExplodedView):
            continue
        moves = []
        for move in view.Group:
            moved = []
            for sub in (move.References or (None, []))[1]:
                # A path of names, ending in the element's, which is empty.
                objects = [doc.getObject(name) for name in sub.split(".")[:-1]]
                if all(objects):
                    moved.append(tuple(o.Label for o in objects))
            moves.append((move.Label, move.MoveType, move.MovementTransform, moved))
        views.append((view.Label, moves))
    return views


def explode(assembly, views: list) -> None:
    """Make exploded() views again, of what the assembly holds now: a move of
    what's still there by its label, and none of what isn't."""
    subs = {}

    def index(group, names: tuple, labels: tuple) -> None:
        for o in group.Group:
            at = (*names, o.Name), (*labels, o.Label)
            subs[at[1]] = ".".join(at[0]) + "."
            if o.TypeId == "App::Part":
                index(o, *at)

    index(assembly, (), ())
    for label, moves in views:
        # As the workbench's own command makes them.
        view = UtilsAssembly.getViewGroup(assembly).newObject(
            "App::FeaturePython", "Exploded View"
        )
        CommandCreateView.ExplodedView(view)
        CommandCreateView.ViewProviderExplodedView(view.ViewObject)
        if view.Label != label:
            view.Label = label
        made = []
        for name, kind, transform, moved in moves:
            found = [subs[path] for path in moved if path in subs]
            if not found:
                continue
            move = assembly.newObject("App::FeaturePython", "Move")
            CommandCreateView.ExplodedViewStep(
                move, CommandCreateView.ExplodedViewStepTypes.index(kind)
            )
            CommandCreateView.ViewProviderExplodedViewStep(move.ViewObject)
            if move.Label != name:
                move.Label = name
            move.MovementTransform = transform
            move.References = [assembly, found]
            # Its lines, which show only while the view is edited.
            move.Visibility = False
            made.append(move)
        view.Group = made


def digest(path: Path) -> bytes:
    return hashlib.sha256(path.read_bytes()).digest()


class Watcher:
    """Reimport `step` into `doc` once it's been written again and has stopped
    changing, so as not to read it half written."""

    def __init__(self, doc, step: Path, saved: Path):
        self.doc_name = doc.Name
        self.step = step
        self.saved = saved
        self.seen = self.stat()
        self.digest = digest(step)
        # What it last saw, which must hold still for one poll before a reload.
        self.pending = None
        self.label = doc.Label
        self.timer = QtCore.QTimer()
        self.timer.timeout.connect(self.poll)
        self.timer.start(POLL)

    def stat(self):
        try:
            s = self.step.stat()
        except OSError:
            return None
        return (s.st_mtime_ns, s.st_size)

    def poll(self) -> None:
        doc = FreeCAD.listDocuments().get(self.doc_name)
        if doc is None:
            # Closed: stop watching.
            self.timer.stop()
            WATCHERS.pop(self.doc_name, None)
            return
        if Gui.Control.activeDialog():
            # A task is open, an exploded view's say, on what a reload would
            # take from under it: wait for it to close.
            return
        now = self.stat()
        if now is None:
            self.pending = None
            self.gone(doc, True)
            return
        if now == self.seen:
            self.pending = None
            return
        if now != self.pending:
            self.pending = now
            return
        self.seen, self.pending = now, None
        try:
            new = digest(self.step)
        except OSError:
            return
        self.gone(doc, False)
        if new == self.digest:
            return
        self.digest = new
        self.reload(doc)

    def gone(self, doc, gone: bool) -> None:
        label = self.label + GONE if gone else self.label
        if doc.Label == label:
            return
        doc.Label = label
        Gui.getDocument(doc.Name).Modified = False
        if gone:
            FreeCAD.Console.PrintWarning(f"{self.step} is missing; showing what it was\n")

    def reload(self, doc) -> None:
        gui = Gui.getDocument(doc.Name)
        view = gui.activeView() if gui else None
        camera = view.getCamera() if view else None
        hidden = {o.Label for o in doc.Objects if not o.Visibility}
        views = exploded(doc)
        # All but the assembly and the groups it keeps its joints and views in.
        assembly = next(
            (o for o in doc.Objects if o.TypeId == "Assembly::AssemblyObject"), None
        )
        kept = {assembly} | {
            o
            for o in (assembly.Group if assembly else [])
            if o.TypeId in ("Assembly::JointGroup", "Assembly::ViewGroup")
        }
        for name in [o.Name for o in doc.Objects if o not in kept]:
            # Removing a group may already have taken what's in it.
            if doc.getObject(name) is not None:
                doc.removeObject(name)
        try:
            ImportGui.insert(str(self.step), doc.Name)
        except Exception as e:
            FreeCAD.Console.PrintError(f"Reloading {self.step}: {e}\n")
            return
        explode(assemble(doc, assembly), views)
        for o in doc.Objects:
            if o.Label in hidden:
                o.Visibility = False
        if view and camera:
            view.setCamera(camera)
        save(doc, self.saved)
        FreeCAD.Console.PrintMessage(f"Reloaded {self.step}\n")


# Kept here, by document, so their timers aren't collected.
WATCHERS = getattr(Gui, "_fit_watchers", {})
Gui._fit_watchers = WATCHERS

Gui.activeDocument().activeView().viewIsometric()
Gui.SendMsgToActiveView("ViewFit")

macro = next(Path(arg) for arg in sys.argv if arg.endswith(".FCMacro"))
root = macro.resolve().parent.parent
step = next((Path(arg) for arg in sys.argv if arg.lower().endswith(".step")), None)
if step is not None:
    step = step.resolve()
    try:
        name = step.relative_to(root)
    except ValueError:
        name = Path(step.name)
    saved = root / "tmp/freecad" / name.with_suffix(".FCStd")
    saved.parent.mkdir(parents=True, exist_ok=True)
    doc = FreeCAD.ActiveDocument
    assemble(doc)
    Gui.activateWorkbench("AssemblyWorkbench")
    save(doc, saved)
    WATCHERS[doc.Name] = Watcher(doc, step, saved)
